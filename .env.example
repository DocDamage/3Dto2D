# SpriteForge local cloud image generation keys.
# Copy this file to .env or app/.env on your own machine.
# Do not put real keys in this example file.

# OpenAI Images API
OPENAI_API_KEY=
# Alternative app-specific name also supported:
# SPRITEFORGE_OPENAI_API_KEY=

# Gemini / Imagen API
GEMINI_API_KEY=
# Alternatives also supported:
# GOOGLE_API_KEY=
# SPRITEFORGE_GEMINI_API_KEY=
