{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spriteforge.local/schemas/asset-revision.v1.json",
  "title": "SpriteForge Immutable Asset Revision",
  "type": "object",
  "required": ["schema", "schema_version", "revision_id", "asset_id", "project_id", "operations", "files"],
  "properties": {
    "schema": {"const": "spriteforge.asset_revision.v1"}, "schema_version": {"const": 1},
    "revision_id": {"type": "string", "minLength": 1}, "asset_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1}, "parent_revision_id": {"type": ["string", "null"]},
    "source_asset_ids": {"type": "array", "items": {"type": "string"}},
    "generation": {"type": "object"}, "metadata": {"type": "object"},
    "operations": {"type": "array", "items": {"type": "object", "required": ["operation_id", "kind", "parameters"]}},
    "files": {"type": "array", "items": {"type": "object", "required": ["name", "sha256"]}}
  }
}
